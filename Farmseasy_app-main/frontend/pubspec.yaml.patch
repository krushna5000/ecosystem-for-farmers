flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true

  assets:
    - assets/images/
    - assets/icons/
    - assets/json/

  fonts:
    - family: Poppins
      fonts:
        - asset: assets/fonts/Poppins-Regular.ttf
        - asset: assets/fonts/Poppins-Bold.ttf

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0
  flutter_launcher_icons: ^0.14.4  # For generating app launcher icon

flutter_icons:
  android: true
  ios: true
  image_path: "assets/icons/final_logo.png"

flutter:
  uses-material-design: true

  assets:
    - assets/icons/final_logo.png
    - assets/illustrations/farmer_illustration.png
