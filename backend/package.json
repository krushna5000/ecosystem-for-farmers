{
  "name": "farmseasy-backend",
  "version": "1.0.0",
  "description": "Unified FarmsEasy backend (Express + Drizzle ORM + PostgreSQL)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seedSuperAdmin.js",
    "test": "node test/run-all.mjs",
    "db:create": "node scripts/create-db.mjs",
    "db:seed:admin": "node scripts/seed-admin.mjs",
    "db:seed:dev": "node scripts/seed-dev-users.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@google/genai": "^2.25.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "formidable": "^3.5.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-kit": "^0.31.11"
  }
}
