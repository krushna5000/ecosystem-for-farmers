# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the API (defaults to 1 in production, 0 otherwise)
# TRUST_PROXY=1
# Extra allowed browser origins, comma separated (all known FarmsEasy frontends are built in)
# CORS_ORIGINS=https://staging.example.com

# ---------- PostgreSQL (Drizzle) — use DATABASE_URL or the DB_* variables ----------
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmseasy
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false            # true for AWS RDS

# ---------- MongoDB (optional: crop-ai diagnosis, weather history, CLSM, stress, indexes) ----------
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=farmseasy

# ---------- Auth ----------
# Each portal signs with its own secret derived from JWT_SECRET (see src/lib/jwt.js),
# so a token from one portal never works on another. Use a long random value.
JWT_SECRET=change-me
REFRESH_SECRET=change-me-too        # vendor refresh tokens
# JWT_RESET_SECRET=                  # optional; vendor password-reset tokens

# ---------- File storage ----------
# S3 is used when all three are set; otherwise files go to ./uploads (served at /uploads)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# PUBLIC_BASE_URL=http://localhost:5000   # base of URLs returned for local-disk uploads

# ---------- Email ----------
# With no credentials (or USE_CONSOLE_EMAIL=true) emails are printed to the console
USE_CONSOLE_EMAIL=true
# EMAIL_USER=
# EMAIL_PASS=
# MAIL_SERVICE=gmail                 # or SMTP_HOST / SMTP_PORT / SMTP_SECURE
# MAIL_FROM=FarmsEasy <no-reply@farmseasy.in>
ADMIN_FRONTEND_URL=http://localhost:5173
COMPANY_FRONTEND_URL=http://localhost:5173
VENDOR_FRONTEND_URL=http://localhost:5176
# BASE_URL=                          # admin e-mail links; falls back to ADMIN_FRONTEND_URL

# ---------- Farmer app integrations ----------
FARMONAUT_API_KEY=
GEMINI_API_KEY=

# ---------- First super admin (npm run db:seed) ----------
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=Super Admin
