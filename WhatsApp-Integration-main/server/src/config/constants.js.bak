        clsmTemplate: (data) => `📊 *फसल जीवनचक्र ट्रैकिंग*\n\n🌱 *फसल:* ${data.clcm_status.crop}\n📈 *वर्तमान चरण:* ${data.clcm_status.current_stage}\n📅 *बुवाई के बाद के दिन:* ${data.clcm_status.das} दिन\n🌡️ *GDD:* ${data.clcm_status.cumulative_gdd}\n\n${data.clcm_status.expected_days_to_next_stage !== "N/A" ? `⏳ *अगला चरण:* ${data.clcm_status.expected_days_to_next_stage} में` : ""}\n\n🦠 *रोग का जोखिम:* ${data.clcm_status.disease_risk === "HIGH" ? "🔴 उच्च" : data.clcm_status.disease_risk === "MODERATE" ? "🟠 मध्यम" : "🟢 कम"}\n📝 *सारांश:*\n${data.clcm_status.summary}\n\n*menu* टाइप करें।`,

        // New Onboarding-specific strings (Updated Flow)
        onboardingLanguageSet: "✅ भाषा चुनी गई!",
        onboardingAskName: "👤 कृपया अपना नाम बताएं:",
        onboardingNameInvalid: "❌ कृपया एक वैध नाम दर्ज करें (कम से कम 2 अक्षर)।",
